<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Australia Summer Run, 2–22 Dec 2026 (Plan A)</name>
  <Style id="stop"><IconStyle><color>ff2a60d1</color><scale>1.1</scale></IconStyle></Style>
  <Style id="car"><IconStyle><color>ff4e8a2f</color></IconStyle></Style>
  <Style id="flight"><LineStyle><color>ffa85f1f</color><width>3</width></LineStyle></Style>
  <Style id="road"><LineStyle><color>ff4e8a2f</color><width>5</width></LineStyle></Style>
  <Folder><name>Stops</name>
    <Placemark><name>1. Sydney (2–5 Dec, 3 nights)</name><styleUrl>#stop</styleUrl><description>Arrive 2 Dec. Main: harbour day, BridgeClimb + Manly ferry.</description><Point><coordinates>151.21,-33.87,0</coordinates></Point></Placemark>
    <Placemark><name>2. Hobart (5–7 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Main: MONA. Also Salamanca Market (Sat 5 Dec), kunanyi bike descent, Bruny Island.</description><Point><coordinates>147.33,-42.88,0</coordinates></Point></Placemark>
    <Placemark><name>3. Airlie Beach (7–10 Dec, 3 nights)</name><styleUrl>#stop</styleUrl><description>Main: Whitsundays sail to Whitehaven + Hill Inlet. Skydive, Heart Reef flight, jet ski.</description><Point><coordinates>148.72,-20.27,0</coordinates></Point></Placemark>
    <Placemark><name>4. Noosa (10–12 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Main: Big Kart Track. Also K'gari 4WD day, Australia Zoo.</description><Point><coordinates>153.09,-26.39,0</coordinates></Point></Placemark>
    <Placemark><name>5. Gold Coast (12–15 Dec, 3 nights)</name><styleUrl>#stop</styleUrl><description>Main: Spilt Milk Sun 13 Dec, Carrara. Theme parks, dirt-bike tour, Kingston Park karts, Surfers clubs.</description><Point><coordinates>153.43,-28.0,0</coordinates></Point></Placemark>
    <Placemark><name>6. Byron Bay (15–17 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Main: surf lesson + Cape Byron walk. Skydive Byron, Beach Hotel.</description><Point><coordinates>153.61,-28.64,0</coordinates></Point></Placemark>
    <Placemark><name>7. Port Stephens (17–19 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Main: Stockton Beach dune buggy / quads. Sandboarding, dolphin cruise.</description><Point><coordinates>152.11,-32.72,0</coordinates></Point></Placemark>
    <Placemark><name>8. Sydney (19–22 Dec, 3 nights)</name><styleUrl>#stop</styleUrl><description>Main: Ivy Pool Club, Kings Cross. Carols in the Domain Sat 19 Dec. Fly home 22 Dec.</description><Point><coordinates>151.21,-33.87,0</coordinates></Point></Placemark>
  </Folder>
  <Folder><name>Car events (parking lot)</name>
    <Placemark><name>Porsche Club NSW party (Plan B)</name><styleUrl>#car</styleUrl><description>Sun 6 Dec, Peppers Craigieburn, Bowral. Email social@pcnsw.com.au.</description><Point><coordinates>150.42,-34.48,0</coordinates></Point></Placemark>
    <Placemark><name>Cars &amp; Coffee, Mount Panorama</name><styleUrl>#car</styleUrl><description>Sun 6 Dec, Bathurst. Confirm.</description><Point><coordinates>149.56,-33.45,0</coordinates></Point></Placemark>
    <Placemark><name>FORBYNATS 2, Sydney Dragway</name><styleUrl>#car</styleUrl><description>Sat 5 Dec, 4x4 show and drags. Confirm.</description><Point><coordinates>150.85,-33.81,0</coordinates></Point></Placemark>
    <Placemark><name>Charity Car Show, Campbell Town</name><styleUrl>#car</styleUrl><description>Sun 13 Dec. Confirm.</description><Point><coordinates>147.49,-41.93,0</coordinates></Point></Placemark>
    <Placemark><name>Maddie Hill Car, Truck &amp; Bike Show</name><styleUrl>#car</styleUrl><description>Sun 13 Dec, Newcastle Kart Racing Club. Confirm.</description><Point><coordinates>151.68,-32.86,0</coordinates></Point></Placemark>
  </Folder>
  <Folder><name>Route</name>
    <Placemark><name>SYD → HBA, 5 Dec</name><styleUrl>#flight</styleUrl><LineString><tessellate>1</tessellate><coordinates>151.21,-33.87,0 147.33,-42.88,0</coordinates></LineString></Placemark>
    <Placemark><name>HBA → PPP, 7 Dec</name><styleUrl>#flight</styleUrl><LineString><tessellate>1</tessellate><coordinates>147.33,-42.88,0 148.72,-20.27,0</coordinates></LineString></Placemark>
    <Placemark><name>PPP → Sunshine Coast/Brisbane, 10 Dec</name><styleUrl>#flight</styleUrl><LineString><tessellate>1</tessellate><coordinates>148.72,-20.27,0 153.09,-26.39,0</coordinates></LineString></Placemark>
    <Placemark><name>Coastal road trip, 12–19 Dec</name><styleUrl>#road</styleUrl><LineString><tessellate>1</tessellate><coordinates>153.09,-26.39,0 153.43,-28.0,0 153.61,-28.64,0 152.11,-32.72,0 151.21,-33.87,0</coordinates></LineString></Placemark>
