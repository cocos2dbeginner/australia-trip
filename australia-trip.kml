<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Australia Summer Run, 2–22 Dec 2026</name>
  <Style id="stop"><IconStyle><color>ff2a60d1</color><scale>1.1</scale></IconStyle></Style>
  <Style id="flight"><LineStyle><color>ffa85f1f</color><width>3</width></LineStyle></Style>
  <Style id="road"><LineStyle><color>ff4e8a2f</color><width>5</width></LineStyle></Style>
  <Folder><name>Stops</name>
    <Placemark><name>1. Sydney (2–4 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Arrive 2 Dec. Harbour, Bondi.</description><Point><coordinates>151.21,-33.87,0</coordinates></Point></Placemark>
    <Placemark><name>2. Melbourne (4–6 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Bangers &amp; Mash drag racing Sat 5 Dec. Chapel St nightlife.</description><Point><coordinates>144.96,-37.81,0</coordinates></Point></Placemark>
    <Placemark><name>3. Bowral (6–7 Dec, 1 night)</name><styleUrl>#stop</styleUrl><description>Porsche Club NSW end-of-year party, Peppers Craigieburn, Sun 6 Dec, $125 pp. Email social@pcnsw.com.au re membership.</description><Point><coordinates>150.42,-34.48,0</coordinates></Point></Placemark>
    <Placemark><name>4. Hobart (7–9 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>MONA, Salamanca Place, kunanyi / Mt Wellington.</description><Point><coordinates>147.33,-42.88,0</coordinates></Point></Placemark>
    <Placemark><name>5. Airlie Beach (9–12 Dec, 3 nights)</name><styleUrl>#stop</styleUrl><description>Skydive. Whitsunday Islands NP sail: Whitehaven Beach, Hill Inlet.</description><Point><coordinates>148.72,-20.27,0</coordinates></Point></Placemark>
    <Placemark><name>6. Noosa (12–13 Dec, 1 night)</name><styleUrl>#stop</styleUrl><description>Big Kart Track, Landsborough. Pick up one-way rental.</description><Point><coordinates>153.09,-26.39,0</coordinates></Point></Placemark>
    <Placemark><name>7. Gold Coast (13–16 Dec, 3 nights)</name><styleUrl>#stop</styleUrl><description>Spilt Milk festival Sun 13 Dec, Carrara. Movie World / Dreamworld. Hinterland dirt bikes. Surfers Paradise nightlife.</description><Point><coordinates>153.43,-28.00,0</coordinates></Point></Placemark>
    <Placemark><name>8. Byron Bay (16–18 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Cape Byron lighthouse walk, beaches, bars.</description><Point><coordinates>153.61,-28.64,0</coordinates></Point></Placemark>
    <Placemark><name>9. Port Stephens (18–20 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Stockton Beach dune buggy, quads, sandboarding. 18 Dec is a ~6.5 h drive.</description><Point><coordinates>152.11,-32.72,0</coordinates></Point></Placemark>
    <Placemark><name>10. Sydney (20–22 Dec, 2 nights)</name><styleUrl>#stop</styleUrl><description>Clubs, then fly home Tue 22 Dec.</description><Point><coordinates>151.21,-33.87,0</coordinates></Point></Placemark>
  </Folder>
